    "request.started",
    "request.progress",
    "stage.changed",
    "tool.started",
    "tool.finished",
    "tool.failed",
    "approval.required",
    "knowledge.progress",
    "shutdown.progress",
    "collecting.started",
    "collecting.completed",
    "tagging.started",
    "tagging.folder_completed",
    "metadata.written",
    "writing.started",
    "writing.file_completed",
    "ingest.completed",
    "ingest.failed",
    "answer.chunk"
